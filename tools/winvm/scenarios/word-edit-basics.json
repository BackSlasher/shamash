{
  "name": "word-edit-basics",
  "setup": [
    "New-Item -Force -ItemType Directory \"$env:USERPROFILE\\Documents\\מאמרים\" | Out-Null; Copy-Item -Force \"\\\\host.lan\\Data\\seed\\מאמרים\\מאמר על ירושלים - לעריכה.docx\" \"$env:USERPROFILE\\Documents\\מאמרים\\\"",
    "powershell -NoProfile -ExecutionPolicy Bypass -File \"\\\\host.lan\\Data\\harness\\word-edit.ps1\" -Path \"$env:USERPROFILE\\Documents\\מאמרים\\מאמר על ירושלים - לעריכה.docx\""
  ],
  "turns": [
    {"say": "מה פתוח עכשיו?", "expect_tools": ["describe_active_document"], "expect_result_prefix": {"describe_active_document": "document: "}},
    {"say": "תדליק מעקב שינויים", "expect_tools": ["set_track_changes"], "expect_result_prefix": {"set_track_changes": "track changes: was off, now on"}},
    {"say": "תעשה פה רווח של שורה וחצי", "expect_tools": ["set_paragraph_spacing"], "expect_result_prefix": {"set_paragraph_spacing": "line spacing: 1.5"}},
    {"say": "תבטל את זה", "expect_tools": ["undo_last_edit"], "expect_result_prefix": {"undo_last_edit": "undone: "}},
    {"say": "תסגור את המסמך בלי לשמור", "expect_tools": ["close_document"]}
  ],
  "expect_state": [
    {"ps": "(Get-Process WINWORD -ErrorAction SilentlyContinue | Measure-Object).Count", "equals": "0"}
  ],
  "teardown": [
    "Get-Process WINWORD -ErrorAction SilentlyContinue | ForEach-Object { $null = $_.CloseMainWindow() }",
    "Remove-Item \"$env:USERPROFILE\\Documents\\מאמרים\\מאמר על ירושלים - לעריכה*.docx\" -ErrorAction SilentlyContinue"
  ]
}
