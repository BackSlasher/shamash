{
  "name": "translate-existing",
  "setup": ["Remove-Item \"$env:USERPROFILE\\Documents\\מכתבים\\*English*.docx\" -ErrorAction SilentlyContinue"],
  "turns": [
    {"say": "תתרגם את המכתב לעירייה לאנגלית ותפתח את התרגום", "expect_tools": ["any:translate_document|open_file"], "max_total_ms": 120000}
  ],
  "expect_state": [
    {"ps": "Test-Path \"$env:USERPROFILE\\Documents\\מכתבים\\*English*.docx\"", "equals": "True"}
  ],
  "teardown": [
    "Get-Process WINWORD -ErrorAction SilentlyContinue | ForEach-Object { $null = $_.CloseMainWindow() }",
    "Remove-Item \"$env:USERPROFILE\\Documents\\מכתבים\\*English*.docx\" -ErrorAction SilentlyContinue"
  ]
}
