<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Debug builds only: the PC-link probe speaks plain ws:// to a LAN or USB-reversed
         address. Release builds keep the platform default (no cleartext). -->
    <application android:networkSecurityConfig="@xml/network_security_config">
        <receiver
            android:name=".pclink.PcLinkReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="net.backslasher.shamash.PCLINK_PROBE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
